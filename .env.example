# Browser (Vite) variables
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# Only for GitHub Pages: full URL of the token function on Vercel
# VITE_TOKEN_URL=https://YOUR-TOKEN-APP.vercel.app/api/get-token

# Server-only variables (Vercel env vars, never prefix with VITE_)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
